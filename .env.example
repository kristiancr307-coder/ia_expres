# Modos validos: mock (sin internet) | openrouter (IA real, solo gratis)
AI_EXECUTION_MODE=mock
PORT=3000
# Interfaz de red: 127.0.0.1 = solo tu maquina.
# Usar 0.0.0.0 en contenedores, Docker, WSL o previews remotos.
HOST=127.0.0.1
# Timeout de la peticion al proveedor, en milisegundos.
# OJO: el codigo lee REQUEST_TIMEOUT_MS (no AI_TIMEOUT_MS).
REQUEST_TIMEOUT_MS=15000
# Solo se usa en modo openrouter. NUNCA se publica en Git.
OPENROUTER_API_KEY=
# Debe existir en el catalogo, terminar en ":free" y tener precio 0.
# Obtener un id vigente: npm run models:list
# NO uses "openrouter/free": no termina en ":free" y la API lo rechaza.
OPENROUTER_MODEL=
